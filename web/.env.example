# Copier en .env.local (jamais versionne) puis redemarrer le serveur.
# Sans cle, Hot-Spot fonctionne avec l'aide hors ligne de l'assistant.
# Un seul fournisseur suffit. Si les deux cles sont presentes, Gemini est utilise
# (forcer avec HOTSPOT_AI_PROVIDER=gemini ou anthropic).

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modeles de secours si le principal est surcharge ou trop lent (dans l'ordre)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=
# HOTSPOT_AI_MODEL=claude-opus-5-5

# --- Options communes ---
# HOTSPOT_AI_EFFORT=low
# HOTSPOT_AI_TIMEOUT_MS=25000
# HOTSPOT_AI_RATE_LIMIT=30
# HOTSPOT_AI_DAILY_LIMIT=1000
# HOTSPOT_AI_DISABLED=1
